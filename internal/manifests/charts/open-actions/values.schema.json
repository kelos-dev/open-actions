{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller", "console", "service"],
  "properties": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "githubAPIURL", "githubServerURL", "actionCloneBaseURL"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "maxLength": 512},
            "tag": {"type": "string", "minLength": 1, "maxLength": 128},
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "githubAPIURL": {"type": "string", "minLength": 1, "maxLength": 2048},
        "githubServerURL": {"type": "string", "minLength": 1, "maxLength": 2048},
        "actionCloneBaseURL": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "console": {
      "type": "object",
      "additionalProperties": false,
      "required": ["enabled", "replicas", "publicURL", "secretName", "tokenKey", "image", "service"],
      "allOf": [
        {
          "if": {"properties": {"enabled": {"const": true}}},
          "then": {"properties": {"publicURL": {"minLength": 1}}}
        }
      ],
      "properties": {
        "enabled": {"type": "boolean"},
        "replicas": {"type": "integer", "minimum": 1, "maximum": 100},
        "publicURL": {"type": "string", "maxLength": 2048},
        "secretName": {
          "type": "string",
          "maxLength": 253,
          "pattern": "^$|^[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?(\\.[a-z0-9]([-a-z0-9]{0,61}[a-z0-9])?)*$"
        },
        "tokenKey": {
          "type": "string",
          "minLength": 1,
          "maxLength": 253,
          "pattern": "^[-._A-Za-z0-9]+$"
        },
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "maxLength": 512},
            "tag": {"type": "string", "minLength": 1, "maxLength": 128},
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "service": {
          "type": "object",
          "additionalProperties": false,
          "required": ["type", "nodePort"],
          "allOf": [
            {
              "if": {"properties": {"nodePort": {"type": "integer"}}},
              "then": {"properties": {"type": {"enum": ["NodePort", "LoadBalancer"]}}}
            }
          ],
          "properties": {
            "type": {
              "type": "string",
              "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
            },
            "nodePort": {
              "type": ["integer", "null"],
              "minimum": 1,
              "maximum": 65535
            }
          }
        }
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodePort"],
      "allOf": [
        {
          "if": {"properties": {"nodePort": {"type": "integer"}}},
          "then": {"properties": {"type": {"enum": ["NodePort", "LoadBalancer"]}}}
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "nodePort": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
