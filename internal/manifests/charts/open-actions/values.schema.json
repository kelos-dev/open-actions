{
  "$schema": "https://json-schema.org/draft-07/schema#",
  "type": "object",
  "additionalProperties": false,
  "required": ["controller", "service"],
  "properties": {
    "controller": {
      "type": "object",
      "additionalProperties": false,
      "required": ["image", "githubAPIURL", "githubServerURL", "actionCloneBaseURL"],
      "properties": {
        "image": {
          "type": "object",
          "additionalProperties": false,
          "required": ["repository", "tag", "pullPolicy"],
          "properties": {
            "repository": {"type": "string", "minLength": 1, "maxLength": 512},
            "tag": {"type": "string", "minLength": 1, "maxLength": 128},
            "pullPolicy": {
              "type": "string",
              "enum": ["Always", "IfNotPresent", "Never"]
            }
          }
        },
        "githubAPIURL": {"type": "string", "minLength": 1, "maxLength": 2048},
        "githubServerURL": {"type": "string", "minLength": 1, "maxLength": 2048},
        "actionCloneBaseURL": {"type": "string", "minLength": 1, "maxLength": 2048}
      }
    },
    "service": {
      "type": "object",
      "additionalProperties": false,
      "required": ["type", "nodePort"],
      "allOf": [
        {
          "if": {"properties": {"nodePort": {"type": "integer"}}},
          "then": {"properties": {"type": {"enum": ["NodePort", "LoadBalancer"]}}}
        }
      ],
      "properties": {
        "type": {
          "type": "string",
          "enum": ["ClusterIP", "NodePort", "LoadBalancer"]
        },
        "nodePort": {
          "type": ["integer", "null"],
          "minimum": 1,
          "maximum": 65535
        }
      }
    }
  }
}
